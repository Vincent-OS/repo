# Maintainer: Florian. M <florian.m@v38armageddon.net>
pkgname="websm"
pkgver=6.0.0
_pkgver=6.0
pkgrel=3
pkgdesc="A simple minimalist web browser on Uno Platform."
url="https://github.com/v38armageddon/WebSM"
license=("EUPL-1.2")
arch=('x86_64')
depends=(
	'dotnet-runtime'
	'webkit2gtk'
	'webkit2gtk-4.1'
)
source=(
	"$url/releases/download/v$_pkgver/WebSM-linux-standalone.tar.xz"
	"net.v38armageddon.WebSM.desktop"
)
sha256sums=('f54e073180191e7de8b201378d50901084ed38653c3e06a877f97919ac61e721'
            '1c174b6451b0b81b293fffce50c9cc38b8ace304b27442053b5c96920a074549')
options=(!strip)
_srcdir="usr/lib/WebSM"

package() {
	mkdir -p "$pkgdir/usr/lib/WebSM" "$pkgdir/usr/share/icons/hicolor/{44x44,64x64,72x72,150x150,310x310,512x512}/apps" "$pkgdir/usr/bin" "$pkgdir/usr/share/applications"
	cp -a "$pkgsrc"* "$pkgdir/$_srcdir"
	install -Dm644 "net.v38armageddon.WebSM.desktop" "$pkgdir/usr/share/applications/net.v38armageddon.WebSM.desktop"
	install -Dm644 $pkgdir/$_srcdir/Assets/Icons/Square44x44Logo.scale-100.png "$pkgdir/usr/share/icons/hicolor/44x44/apps/net.v38armageddon.WebSM.png"
	install -Dm644 $pkgdir/$_srcdir/Assets/Icons/StoreLogo.scale-125.png "$pkgdir/usr/share/icons/hicolor/64x64/apps/net.v38armageddon.WebSM.png"
	install -Dm644 $pkgdir/$_srcdir/Assets/Icons/SmallTile.scale-125.png "$pkgdir/usr/share/icons/hicolor/72x72/apps/net.v38armageddon.WebSM.png"
	install -Dm644 $pkgdir/$_srcdir/Assets/Icons/Square150x150Logo.scale-100.png "$pkgdir/usr/share/icons/hicolor/150x150/net.v38armageddon.WebSM.png"
	install -Dm644 $pkgdir/$_srcdir/Assets/Icons/LargeTile.scale-100.png "$pkgdir/usr/share/icons/hicolor/310x310/apps/net.v38armageddon.WebSM.png"
	install -Dm644 $pkgdir/$_srcdir/Assets/Icons/icon_foreground.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/net.v38armageddon.WebSM.png"
	chmod 755 "$pkgdir/$_srcdir/WebSM"
	ln -s "/usr/lib/WebSM/WebSM" "$pkgdir/usr/bin/WebSM"
}
