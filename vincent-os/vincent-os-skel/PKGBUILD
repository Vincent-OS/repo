pkgname=vincent-os-skel
pkgver=1.0.1
pkgrel=1
pkgdesc="Vincent OS skeleton package"
arch=('any')
license=('EUPL-1.2')
url='https://vincent-os.v38armageddon.net'
depends=('vincent-os-filesystem')
source=("skel.tar.xz") # HACK: Make local archive for fuck knows why. THIS ACTION MUST BE MADE MANUALLY
sha256sums=('de9ff69adad69e3edea923226fcff7f97c3a76af9c010c169775548208bb7633')

package () {
	mkdir -p "${pkgdir}/etc/skel/" "${srcdir}/skel/"
	tar -xf "${srcdir}/skel.tar.xz" -C "${srcdir}/skel/"
	cp -a "${srcdir}/skel/"* "${pkgdir}/etc/"
}
